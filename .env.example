# Database
DATABASE_URL="postgresql://user:password@localhost:5432/e_voting"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# Node Environment
NODE_ENV="development"

# Server Configuration
PORT=10000
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Optional: Email/SMTP Configuration
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-email@example.com"
SMTP_PASS="your-email-password"
SMTP_FROM="noreply@voting.example.com"

# Optional: Error Tracking (Sentry)
SENTRY_DSN=""

# Optional: Admin API
ADMIN_API_JWT_SECRET="your-admin-api-secret"
ADMIN_API_PORT="4000"

# Database Backup
BACKUP_DIR="./backups"
PGHOST="localhost"
PGUSER="postgres"
PGDATABASE="e_voting"
PGPASSWORD="postgres"
